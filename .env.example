# PostgreSQL
POSTGRES_DB=diagnostics
POSTGRES_USER=diagnostics
POSTGRES_PASSWORD=replace-with-a-long-random-alphanumeric-password
DATABASE_URL=postgresql+psycopg://diagnostics:replace-with-a-long-random-alphanumeric-password@postgres:5432/diagnostics

# Redis
REDIS_URL=redis://redis:6379/0

# Agent authentication
AGENT_TOKEN=replace-with-a-long-random-token

# Dashboard administrator
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=replace-with-a-generated-password-hash

# Session security
SESSION_SECRET=replace-with-a-long-random-secret
SESSION_COOKIE_SECURE=false

# Local development origins
TRUSTED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8000,http://localhost:8000
